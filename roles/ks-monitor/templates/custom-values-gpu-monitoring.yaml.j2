# Default values for NVIDIA DCGM exporter.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.

image:
  repository: {{ dcgm_repo }}
  pullPolicy: IfNotPresent
  tag: 3.3.9-3.6.1-ubuntu22.04

resources:
  limits:
    cpu: {{ monitoring.gpu.nvidia_dcgm_exporter.resources.limits.cpu | default("100m") }}
    memory: {{ monitoring.gpu.nvidia_dcgm_exporter.resources.limits.memory | default("512Mi") }}
  requests:
    cpu: {{ monitoring.gpu.nvidia_dcgm_exporter.resources.requests.cpu | default("100m") }}
    memory: {{ monitoring.gpu.nvidia_dcgm_exporter.resources.requests.memory | default("512Mi") }}

imagePullSecrets: []

tolerations: []
# - operator: Exists

nodeSelector: {}
  # node: gpu

affinity:
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
      - matchExpressions:
        - key: nvidia.com/gpu.present
          operator: Exists

# Disable ServiceMonitor — Prometheus scrapes gpu-agent exporter instead of dcgm-exporter directly
serviceMonitor:
  enabled: false

# Enable pod labels to include pod-level GPU metrics (namespace, pod_name, etc.)
# Note: This requires dcgm-exporter to query Kubernetes API for pod information,
# which may cause API throttling in large clusters. The ClusterRole we created
# earlier provides the necessary permissions.
extraEnv:
  - name: DCGM_EXPORTER_KUBERNETES_ENABLE_POD_LABELS
    value: "true"

