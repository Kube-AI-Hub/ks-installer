{{- /*
Copyright 2026 Kube AI Hub.

Values for the juicefs chart. Rendered by
roles/common/tasks/juicefs-install.yaml.

The StorageClass is named juicefs-shared on purpose: csghub-server selects
ReadWriteMany for a class whose name matches "shared".

Attribute access goes through .get() rather than Jinja attribute lookups: a
missing key under common.juicefs would otherwise raise instead of falling back
to the default written here.
*/ -}}
{% set jf = common.juicefs | default({}) %}
{% set jf_image = jf.get('image', {}) %}
{% set jf_mount = jf.get('mountImage', {}) %}
{% set jf_metadb = jf.get('metadb', {}) %}
{% set jf_sc = jf.get('storageClass', 'juicefs-shared') %}
{% set jf_static = jf.get('staticVolumes', {}) %}

# One registry prefix for every image below; a site that mirrors images keeps its
# layout unchanged. See common.juicefs.imageRegistry.
imageRegistry: {{ jf.get('imageRegistry', '') }}

image:
  repository: {{ jf_image.get('repository', 'juicedata/juicefs-csi-driver') }}
  tag: "{{ jf_image.get('tag', 'v0.27.0') }}"
  pullPolicy: {{ jf_image.get('pullPolicy', 'IfNotPresent') }}
  pullSecrets: {{ jf_image.get('pullSecrets', []) | tojson }}

mountImage:
  repository: {{ jf_mount.get('repository', 'juicedata/mount') }}
  tag: "{{ jf_mount.get('tag', 'ce-v1.2.0') }}"
  pullPolicy: {{ jf_mount.get('pullPolicy', 'IfNotPresent') }}

storageClass:
  name: {{ jf_sc }}
  reclaimPolicy: {{ jf.get('reclaimPolicy', 'Retain') }}
  volumeBindingMode: {{ jf.get('volumeBindingMode', 'Immediate') }}
  allowVolumeExpansion: {{ jf.get('allowVolumeExpansion', true) }}

volume:
  name: {{ jf.get('volumeName', 'kubeaihub') }}
  storage: s3
  # The object store URL plus the bucket the data blocks live in. common.s3 has
  # no defaults: a missing endpoint is a configuration error, not something to
  # paper over with an in-cluster service name.
  bucket: "{{ common.s3.endpoint }}/{{ jf.get('bucket', 'jfs') }}"
  secure: {{ common.s3.disableSSL | default(true) | ternary(false, true) }}
  accessKey: "{{ common.s3.accessKeyID }}"
  secretKey: "{{ common.s3.secretAccessKey }}"
  metaurl: >-
    {{
      jf.metaurl | default(
        'postgres://'
        ~ jf_metadb.get('username', 'juicefs')
        ~ ':' ~ juicefs_metadb_password_lookup.stdout
        ~ '@juicefs-metadb.kubesphere-system.svc:'
        ~ jf_metadb.get('port', 5432)
        ~ '/' ~ jf_metadb.get('database', 'juicefs_meta')
      )
    }}

node:
  kubeletDir: {{ jf.get('kubeletDir', '/var/lib/kubelet') }}
  updateConfDir: {{ jf.get('updateConfDir', '/etc/juicefs') }}
  {%- set jf_node = jf.get('node', {}) %}
  # Node local block cache. Models are written once and read back by every
  # replica started on the node, so this is what turns a repeated start into a
  # local read. Point it at the disk with room: on a site whose data disk is not
  # /data, set common.juicefs.node.cacheDir.
  cacheDir: {{ jf_node.get('cacheDir', '/data/juicefs-cache') }}
  cacheSize: "{{ jf_node.get('cacheSize', '') }}"
  prefetch: {{ jf_node.get('prefetch', 8) }}
  bufferSize: "{{ jf_node.get('bufferSize', '2048') }}"
  verifyCacheChecksum: {{ jf_node.get('verifyCacheChecksum', 'none') }}
  freeSpaceRatio: "{{ jf_node.get('freeSpaceRatio', '0.1') }}"
  cacheEviction: {{ jf_node.get('cacheEviction', '2-random') }}

driverOptions:
  logLevel: {{ jf.get('logLevel', 5) }}
  mountPod: true

# Volumes whose directory inside the JuiceFS filesystem is a name we chose, so
# that an operator uploading a model and a pod mounting one can agree on a path
# that does not change when a claim is rebuilt. The claim itself is created by
# the component that consumes it (see the runner and csghub charts), because a
# static PV binds to exactly one claim in exactly one namespace.
#
# The model cache lives here because the whole platform reads it: the inference
# warmup job writes into it, csghub-server browses it, and every deploy mounts a
# directory inside it. Its `public` subdirectory is the one models are uploaded
# to and served from.
staticVolumes:
  kubeaihub-model-cache:
    subPath: {{ jf_static.get('modelCachePath', 'model-cache') }}
    claimNamespace: {{ jf_static.get('modelCacheClaimNamespace', 'spaces') }}
    claimName: {{ jf_static.get('modelCacheClaimName', 'csghub-model-cache') }}
    capacity: {{ jf_static.get('modelCacheCapacity', '1Ti') }}
  kubeaihub-public-models:
    subPath: {{ jf_static.get('publicModelsPath', 'model-cache/public') }}
    claimNamespace: {{ jf_static.get('publicModelsClaimNamespace', 'csghub') }}
    claimName: {{ jf_static.get('publicModelsClaimName', 'public-models') }}
    capacity: {{ jf_static.get('publicModelsCapacity', '1Ti') }}
