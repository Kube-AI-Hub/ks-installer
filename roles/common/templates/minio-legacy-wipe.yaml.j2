---
apiVersion: v1
kind: Pod
metadata:
  name: minio-data-wipe
  namespace: kubesphere-system
  labels:
    app: minio-legacy-migration
spec:
  restartPolicy: Never
  containers:
    - name: wipe
      image: {{ busybox_repo }}:{{ busybox_tag }}
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -ec
        - |
          echo "Contents before wipe:"
          ls -la /data/ || true
          rm -rf /data/*
          rm -rf /data/.minio.sys
          rm -rf /data/.[!.]*
          echo "Contents after wipe:"
          ls -la /data/
      securityContext:
        runAsUser: 0
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: minio
