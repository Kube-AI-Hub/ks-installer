---
apiVersion: batch/v1
kind: Job
metadata:
  name: minio-legacy-restore
  namespace: kubesphere-system
  labels:
    app: minio-legacy-migration
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app: minio-legacy-migration
    spec:
      restartPolicy: OnFailure
      containers:
        - name: mc
          image: "{{ mc_repo }}:{{ mc_tag }}"
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -ec
            - |
              mc alias set dst http://minio.kubesphere-system.svc:9000 "${MINIO_ROOT_USER}" "${MINIO_ROOT_PASSWORD}"
              ATTEMPTS=0
              until mc admin info dst >/dev/null 2>&1; do
                ATTEMPTS=$((ATTEMPTS + 1))
                if [ "$ATTEMPTS" -gt 60 ]; then
                  echo "MinIO not ready"
                  exit 1
                fi
                sleep 2
              done
              mc mirror --preserve --overwrite /backup/ dst/
              echo "Restore completed."
          env:
            - name: MINIO_ROOT_USER
              value: "openpitrixminioaccesskey"
            - name: MINIO_ROOT_PASSWORD
              value: "openpitrixminiosecretkey"
          volumeMounts:
            - name: backup
              mountPath: /backup
      volumes:
        - name: backup
          persistentVolumeClaim:
            claimName: minio-backup
